# Copy to .env and adjust. Every Hatch setting is prefixed with HATCH_.
# Never commit .env and never paste secrets into Todoist.

HATCH_ENV=development

# Postgres (docker compose service "db"; start with `make db-up`).
HATCH_DATABASE_URL=postgresql+psycopg://hatch:hatch@localhost:54329/hatch

# Generated media. "local" stores files under HATCH_ASSET_DIR. "s3" stores them
# in an S3-compatible bucket (Cloudflare R2 / AWS S3) and uses HATCH_ASSET_DIR
# as a download cache.
HATCH_ASSET_STORE=local
HATCH_ASSET_DIR=var/assets
# HATCH_S3_BUCKET=
# HATCH_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# HATCH_S3_REGION=auto
# HATCH_S3_ACCESS_KEY_ID=
# HATCH_S3_SECRET_ACCESS_KEY=
# Public HTTPS base URL of the bucket (publishers fetch the video from here).
# HATCH_ASSET_PUBLIC_BASE_URL=https://media.example.com

# Publishing through Buffer (personal API key; owner account).
HATCH_BUFFER_API_KEY=
# Daily posting times per IP (UTC). Two slots = two videos per IP per day.
HATCH_PUBLISH_SLOTS_UTC=15:00,21:00

# Media generation: "higgsfield" (paid) or "fake" (free synthetic test videos).
HATCH_MEDIA_PROVIDER=higgsfield
# Higgsfield API key id + secret from https://cloud.higgsfield.ai (prepaid API,
# not the web subscription). Required when HATCH_MEDIA_PROVIDER=higgsfield.
HATCH_HIGGSFIELD_API_KEY=
HATCH_HIGGSFIELD_API_SECRET=

# Platform analytics (official APIs). After filling these in, authorise each
# account once with `hatch auth youtube|tiktok|meta`; tokens are stored in
# HATCH_CREDENTIALS_FILE (owner-only, git-ignored).
# HATCH_CREDENTIALS_FILE=var/credentials.json
HATCH_YOUTUBE_CLIENT_ID=
HATCH_YOUTUBE_CLIENT_SECRET=
HATCH_TIKTOK_CLIENT_KEY=
HATCH_TIKTOK_CLIENT_SECRET=
HATCH_META_APP_ID=
HATCH_META_APP_SECRET=

# Language model for creative agents (hypotheses, novelty) and content QA.
# Anthropic API key from https://platform.claude.com — every call is priced,
# budget-checked and recorded in the ledger like any other paid operation.
HATCH_ANTHROPIC_API_KEY=
HATCH_LLM_MODEL=claude-opus-5-5
HATCH_LLM_EFFORT=high

# Name recorded on human review decisions (defaults to the OS user).
# HATCH_REVIEWER=

# Force every new candidate onto one video model (must be in the catalogue).
# Leave unset to let the router choose by cost, quality and reliability.
# HATCH_VIDEO_MODEL_OVERRIDE=alibaba/wan-3.0/text-to-video

# Budget contract (USD). Only the human operator may raise these.
HATCH_BUDGET_TARGET_PER_VIDEO_USD=0.50
HATCH_BUDGET_MAX_PER_VIDEO_USD=1.50
HATCH_BUDGET_MAX_PER_GENERATION_USD=0.75
HATCH_BUDGET_DAILY_USD=15.00
HATCH_BUDGET_MONTHLY_USD=500.00
